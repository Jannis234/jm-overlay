diff -ru SatDump-1.2.2_orig/src-core/common/calibration.cpp SatDump-1.2.2/src-core/common/calibration.cpp
--- SatDump-1.2.2_orig/src-core/common/calibration.cpp	2024-11-29 13:58:19.000000000 +0100
+++ SatDump-1.2.2/src-core/common/calibration.cpp	2026-09-03 23:14:10.743526391 +0200
@@ -4,6 +4,10 @@
 #include <vector>
 #include <ctime>
 
+#define c1 1.1910427e-05
+#define c2 1.4387752
+#define e_num 2.7182818
+
 double temperature_to_radiance(double t, double v) { return (c1 * v * v * v) / (pow(e_num, c2 * v / t) - 1); }
 
 double radiance_to_temperature(double L, double v) { return (c2 * v) / (log(c1 * v * v * v / L + 1)); }
